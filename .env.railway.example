# Paste these into the HAPPI API service's Variables tab in the Railway
# development environment. Replace service namespaces if yours differ.
NODE_ENV=development
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
DATABASE_SSL=true

# Set these after Railway creates public domains for the frontends.
WEB_URL=https://replace-with-web-development-domain
ADMIN_URL=https://replace-with-admin-development-domain

# Generate unique development values and seal them in Railway.
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-32-character-random-key

# Provider integrations remain unset until selected/configured.
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=
VIDEO_PROVIDER=
VIDEO_API_KEY=
EMAIL_FROM=notifications@example.com
