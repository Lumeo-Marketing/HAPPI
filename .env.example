# Replace these before implementing authentication or encryption.
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-32-character-random-key

# Provider integrations are deliberately unset until selected/configured.
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_HMAC_KEY=
VIDEO_PROVIDER=
VIDEO_API_KEY=
EMAIL_FROM=notifications@example.com
