NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=happi_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Use this instead of the individual DATABASE_* values in hosted environments.
DATABASE_URL=
DATABASE_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
